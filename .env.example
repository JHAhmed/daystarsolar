# Contentful — projects and blog posts. Read-only delivery token.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Supabase — reports, contact submissions, mailing list.
# These keep the PUBLIC_ prefix they have always had in the Vercel project so
# the existing deployment config keeps working, but the client is only ever
# constructed inside $lib/server. The anon key is safe to expose by design;
# row-level security is what actually governs access.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Resend — contact form notifications.
RESEND_API_KEY=

# OpenAI — blog draft generation, and the optional TNEB bill lookup.
OPENAI_API_KEY=

# Write guard.
# Unset or "false" in development means Supabase inserts and outbound email are
# logged instead of performed, so local testing never writes to live tables or
# mails products@/info@. Reads are always live. Production always writes.
ENABLE_WRITES=false
